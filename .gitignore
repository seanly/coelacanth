# Eclipse build output: module dirs copied under bin/ (bin/pom.xml, bin/target/, ...).
# Scoped to module roots so the tracked Karaf launcher scripts in
# assemblies/nexus-base-overlay/src/main/resources/overlay/bin/ are not matched.
/components/*/bin/
/plugins/*/bin/
/testsuite/*/bin/
/assemblies/*/bin/
/buildsupport/*/bin/
.factorypath

